{
  "name": "minicloud",
  "version": "0.1.0",
  "private": true,
  "description": "MiniCloud - a lightweight local PaaS inspired by Render, Heroku, Railway and Fly.io",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "dev": "npm run dev --workspace @minicloud/api",
    "dev:dashboard": "npm run dev --workspace @minicloud/dashboard",
    "db:up": "docker compose up -d postgres && npm run migrate --workspace @minicloud/db",
    "migrate": "npm run migrate --workspace @minicloud/db",
    "test:e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
