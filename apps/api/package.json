{
  "name": "@minicloud/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node --experimental-strip-types src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/pipeline.integration.test.ts src/config.integration.test.ts",
    "test:unit": "npm test"
  },
  "dependencies": {
    "@minicloud/db": "*",
    "@minicloud/deployment-engine": "*",
    "@minicloud/docker-runtime": "*",
    "@minicloud/shared": "*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "light-my-request": "^5.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
