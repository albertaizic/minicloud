# --- MiniCloud configuration -------------------------------------------------
# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL connection used by the API and migrations
DATABASE_URL=postgres://minicloud:minicloud@localhost:5432/minicloud

# API server
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Dashboard talks to the API here (Vite dev proxy target)
MINICLOUD_API_URL=http://localhost:4000

# Deployment engine
# Root directory where repositories are cloned and images built
WORKSPACE_DIR=./.minicloud/workspace
# Host port range used for deployed containers
PORT_RANGE_START=31000
PORT_RANGE_END=31999
# Health check defaults
HEALTH_PATH_DEFAULT=/health
HEALTH_TIMEOUT_SECONDS=60
HEALTH_INTERVAL_SECONDS=2
# Crash monitor poll interval (ms)
CRASH_MONITOR_INTERVAL_MS=5000
