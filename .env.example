# --- MiniCloud configuration -------------------------------------------------
# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL connection used by the API and migrations
# Host port for the MiniCloud postgres container (change if 5433 is taken,
# e.g. when a local PostgreSQL already listens on 5432)
POSTGRES_HOST_PORT=5433

DATABASE_URL=postgres://minicloud:minicloud@localhost:5433/minicloud

# API server
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development


# Master key for encrypting application secrets at rest (AES-256-GCM).
# Required only when you use secrets; plain env vars and limits work without it.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit the real value. Losing this key makes stored secrets
# undecryptable; changing it requires re-entering all secrets.
MINICLOUD_MASTER_KEY=

# Dashboard talks to the API here (Vite dev proxy target)
MINICLOUD_API_URL=http://localhost:4000

# Deployment engine
# Root directory where repositories are cloned and images built
WORKSPACE_DIR=./.minicloud/workspace
# Host port range used for deployed containers
PORT_RANGE_START=31000
PORT_RANGE_END=31999
# Health check defaults
HEALTH_PATH_DEFAULT=/health
HEALTH_TIMEOUT_SECONDS=60
HEALTH_INTERVAL_SECONDS=2
# Crash monitor poll interval (ms)
CRASH_MONITOR_INTERVAL_MS=5000
